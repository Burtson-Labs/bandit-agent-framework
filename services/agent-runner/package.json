{
  "name": "@burtson-labs/agent-runner",
  "version": "1.0.64",
  "author": {
    "name": "Burtson Labs",
    "email": "team@burtson.ai",
    "url": "https://burtson.ai"
  },
  "private": true,
  "description": "HTTP host for the Bandit agent runtime \u2014 the service the commercial gateway delegates cloud turns to. Task in, NDJSON events out.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/server.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@burtson-labs/agent-core": "workspace:*",
    "@burtson-labs/host-kit": "workspace:*",
    "@burtson-labs/stealth-core-runtime": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.0.10"
  }
}
