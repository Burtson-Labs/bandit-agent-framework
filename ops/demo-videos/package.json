{
  "name": "@burtson-labs/demo-videos",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright-recorded Bandit demo videos with Bandit TTS narration, a ducked music bed, and burned-in subtitles. Output goes to ~/Desktop/bandit-demos only — nothing is published.",
  "type": "module",
  "scripts": {
    "demo": "tsx src/run.ts",
    "narrate": "tsx src/narrate.ts",
    "record": "tsx src/record.ts",
    "assemble": "bash assemble.sh",
    "fetch-music": "bash scripts/fetch-music.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.19.24",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
