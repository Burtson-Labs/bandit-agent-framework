  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "clean": "turbo run clean",
    "demo": "pnpm --filter agent-node-demo run demo",
    "bump:patch": "node scripts/bump-patch.mjs"
