      "postcss": ">=8.5.18 <9.0.0",
      "rollup": ">=4.59.0 <5.0.0",
      "tmp": ">=0.2.6 <0.3.0",
      "underscore": ">=1.13.8 <2.0.0",
      "undici": ">=7.29.0 <8.0.0",
      "vite": ">=6.4.3 <7.0.0",
