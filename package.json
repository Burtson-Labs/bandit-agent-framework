  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.19.24",
    "eslint": "^9.39.1",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
