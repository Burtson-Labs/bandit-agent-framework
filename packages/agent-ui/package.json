{
  "name": "@burtson-labs/agent-ui",
  "version": "1.0.88",
  "author": {
    "name": "Burtson Labs",
    "email": "team@burtson.ai",
    "url": "https://burtson.ai"
  },
  "description": "UI primitives for the Bandit Agent Framework.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles/*": "./styles/*",
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Burtson-Labs/bandit-agent-framework.git",
    "directory": "packages/agent-ui"
  },
  "bugs": {
    "url": "https://github.com/Burtson-Labs/bandit-agent-framework/issues"
  },
  "homepage": "https://github.com/Burtson-Labs/bandit-agent-framework/tree/main/packages/agent-ui#readme",
  "funding": "https://afsp.org/chapter/missouri",
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "prebuild": "pnpm -C ../.. --filter @burtson-labs/core-chat build && pnpm -C ../.. --filter @burtson-labs/agent-core build",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/mark-esm.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@burtson-labs/core-chat": "workspace:*",
    "@burtson-labs/agent-core": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.1.5",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "clsx": "^2.1.0",
    "dompurify": "^3.4.5",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.2.0",
    "morphdom": "^2.7.4"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.0.0",
    "@emotion/styled": ">=11.0.0",
    "@mui/icons-material": ">=7.0.0",
    "@mui/material": ">=7.0.0",
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "19.2.2",
    "happy-dom": "^19.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vitest": "^4.0.10"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "agentic",
    "tool-use",
    "bandit",
    "local-first",
    "ollama",
    "agent-ui"
  ],
  "publishConfig": {
    "access": "public"
  }
}
